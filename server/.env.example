# คัดลอกเป็น .env แล้วเติมค่าจริง — ห้าม commit .env
# ตอน deploy ให้ตั้งค่าพวกนี้เป็น environment variables บน host แทน

# PaaS ส่วนใหญ่ (Render/Railway) กำหนด PORT ให้เอง — ปล่อยว่างได้
PORT=3001
NODE_ENV=development

# origin ของ client ที่อนุญาตให้เรียก API (CORS)
# same-origin deploy (server เสิร์ฟ client/dist เอง) ไม่ได้ใช้ค่านี้ แต่ตั้งไว้ก็ไม่เสียหาย
# ใส่หลาย origin ได้ คั่นด้วย comma
CLIENT_URL=http://localhost:5173

# ── Database (MySQL/MariaDB เช่น XAMPP ในเครื่อง) ──────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=were_not_wolf
# If your managed DB requires SSL (Aiven/PlanetScale/etc), set DB_SSL=true in production
# Accepts: true, 1, yes (case-insensitive)
DB_SSL=false
# Optional: Provide a CA certificate for the managed DB to enable certificate
# verification. Two options:
# - DB_SSL_CA_PATH: path on disk to PEM file (recommended when mounting secrets)
# - DB_SSL_CA_B64: base64-encoded PEM contents (useful for platform env vars)
# If a CA is provided the connection will use rejectUnauthorized=true.
DB_SSL_CA_PATH=
DB_SSL_CA_B64=

# ต้องเปลี่ยนเป็นค่าสุ่มยาว ๆ ตอน production — session ทั้งระบบขึ้นกับค่านี้
SESSION_SECRET=change-this-to-a-long-random-string

# NOTE ABOUT PRODUCTION / COOKIES:
# When deploying behind an HTTPS proxy (Render, Cloudflare, etc) set NODE_ENV=production
# so cookies are marked secure and the app trusts the proxy (app.set('trust proxy', 1)).
# Example for Render: set NODE_ENV=production and ensure your session secret is a long random value.

# Google OAuth (Google Cloud Console > Credentials)
# GOOGLE_CALLBACK_URL ต้องตรงเป๊ะกับที่ลงทะเบียนใน Authorized redirect URIs
# dev  : http://localhost:3001/api/auth/google/callback
# prod : https://<your-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
